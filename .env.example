# Copy values into your shell environment. Do not store real keys in this file.
BINANCE_API_KEY=read_only_hmac_api_key
BINANCE_API_SECRET=read_only_hmac_api_secret
PREDICT_SIM_PORT=8766

# Real-money M0W is disabled unless this explicit flag is enabled. Prefer a
# separate Prediction-trading key; if omitted, the server reuses the two keys
# above only after PREDICT_LIVE_ENABLED is true.
PREDICT_LIVE_ENABLED=false
BINANCE_LIVE_API_KEY=prediction_trade_hmac_api_key
BINANCE_LIVE_API_SECRET=prediction_trade_hmac_api_secret
PREDICT_LIVE_ACCOUNT_TYPE=SPOT

# Auto-redeem is independent from opening new real-money orders. It scans every
# 15 seconds and claims exact PENDING_CLAIM winners 60 seconds after settlement.
PREDICT_AUTO_REDEEM_ENABLED=true

# Restart the API after five consecutive transport failures while syncing
# Binance order history. The supervisor caps restart storms at three restarts
# per ten minutes and waits five seconds before each restart.
PREDICT_API_RESTART_ERROR_THRESHOLD=5
PREDICT_API_MAX_RESTARTS=3
PREDICT_API_RESTART_WINDOW_SECONDS=600
PREDICT_API_RESTART_DELAY_SECONDS=5

# Preserve one full week of 250 ms microstructure snapshots for causal
# seven-day market-path replays. Raw websocket events remain on their shorter
# retention policy.
PREDICT_MICRO_SNAPSHOT_RETENTION_HOURS=168
