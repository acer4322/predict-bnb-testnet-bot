# Copy values into your shell environment. Do not store real keys in this file.
BINANCE_API_KEY=read_only_hmac_api_key
BINANCE_API_SECRET=read_only_hmac_api_secret
PREDICT_SIM_PORT=8766

# Real-money M0W is disabled unless this explicit flag is enabled. Prefer a
# separate Prediction-trading key; if omitted, the legacy BTC server may reuse
# the read-only pair only after its own master is explicitly enabled.
PREDICT_LIVE_ENABLED=false
BINANCE_LIVE_API_KEY=prediction_trade_hmac_api_key
BINANCE_LIVE_API_SECRET=prediction_trade_hmac_api_secret
PREDICT_LIVE_ACCOUNT_TYPE=SPOT

# Dedicated Polymarket -> Binance Prediction 5m Echtgeld engines.
# Starting Dashboard V2 does NOT enable any of these runtimes automatically.
# BTC keeps its existing master; ETH/BNB have separate master switches and DBs.
PREDICT_POLY_GAP_LIVE_ENABLED=false
PREDICT_ETH_POLY_GAP_LIVE_ENABLED=false
PREDICT_BNB_POLY_GAP_LIVE_ENABLED=false
PREDICT_MULTI_PREDICTION_ENABLED=true
# ETH/BNB child executors intentionally require BINANCE_LIVE_* and remove the
# general BINANCE_API_* pair from their process environment before execution.

# Predict.fun mainnet market-data API key. Dashboard V2's optional 8771 observer
# reads this key only from the process environment, uses REST for strict current
# BTC/ETH/BNB 5m discovery and WebSocket order books for live trajectories, and
# exposes no order/JWT endpoint. Never commit a real key here.
PREDICT_FUN_API_KEY=predict_fun_read_only_api_key

# Read-only BTC 5M wallet reverse-engineering observer. It reuses the
# PREDICT_FUN_API_KEY above, reads the current Predict market from 8771, and
# publishes target fills vs causal PAPER shadow events on 8776. It has no order
# write endpoint. Change the address here to research a different wallet later.
PREDICT_WALLET_SHADOW_TARGET_ADDRESS=0x6da6cb464f92ae7ad4ec3d239c81719cb1d0ae03
PREDICT_WALLET_SHADOW_PORT=8776
PREDICT_WALLET_SHADOW_POLL_SECONDS=1.0
PREDICT_WALLET_SHADOW_MAKER_UNIT=18
PREDICT_WALLET_SHADOW_MAKER_GRID=0.01
# Hard bounded storage window. Values are clamped to 1..30 days by the service;
# default 7 days prevents wallet target/shadow/result rows from accumulating forever.
PREDICT_WALLET_SHADOW_RETENTION_DAYS=7
PREDICT_WALLET_SHADOW_CLEANUP_MINUTES=10
PREDICT_WALLET_SHADOW_SETTLEMENT_POLL_SECONDS=5

# Taker V1 is an additional PAPER-ONLY A/B group. V0 remains unchanged.
# V1 follows a recent same-side maker fill when the current ask is within about
# 1-2 ticks, plus a small probe when the independent core direction flips.
# Inventory is a limiter only; it never chooses V1 direction.
PREDICT_WALLET_SHADOW_TAKER_V1_BASE_SHARES=12
PREDICT_WALLET_SHADOW_TAKER_V1_CORE_FLIP_SHARES=10
PREDICT_WALLET_SHADOW_TAKER_V1_MAX_EVENT_SHARES=18
PREDICT_WALLET_SHADOW_TAKER_V1_MAX_NET_SHARES=90
PREDICT_WALLET_SHADOW_TAKER_V1_MAX_TOTAL_SHARES=600
PREDICT_WALLET_SHADOW_TAKER_V1_FOLLOW_MAX_PRICE_DELTA=0.025
PREDICT_WALLET_SHADOW_TAKER_V1_FOLLOW_MAX_LAG_SECONDS=2.5
PREDICT_WALLET_SHADOW_TAKER_V1_MAX_ASK=0.90
PREDICT_WALLET_SHADOW_TAKER_V1_COOLDOWN_SECONDS=1.2

# Auto-redeem is independent from opening new real-money orders. It scans every
# 15 seconds and claims exact PENDING_CLAIM winners 60 seconds after settlement.
PREDICT_AUTO_REDEEM_ENABLED=true

# Restart the API after five consecutive transport failures while syncing
# Binance order history. The supervisor caps restart storms at three restarts
# per ten minutes and waits five seconds before each restart.
PREDICT_API_RESTART_ERROR_THRESHOLD=5
PREDICT_API_MAX_RESTARTS=3
PREDICT_API_RESTART_WINDOW_SECONDS=600
PREDICT_API_RESTART_DELAY_SECONDS=5

# Preserve one full week of 250 ms microstructure snapshots for causal
# seven-day market-path replays. Raw websocket events remain on their shorter
# retention policy.
PREDICT_MICRO_SNAPSHOT_RETENTION_HOURS=168
