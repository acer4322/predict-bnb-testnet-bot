+    assert reference["stage"] == "PLACE_OUTCOME_UNKNOWN_NO_RETRY"
+    assert len(calls) == client.place_calls == 1
+    durable = json.loads((tmp_path / "PRIVATE_REFERENCE.json").read_text())
