+def test_throttled_read_preserves_ack_and_does_not_repeat(tmp_path):
+    calls=[]
+    def transport(request):
+        calls.append(request)
+        return httpx.Response(429, headers={"Retry-After":"30"}, json={"success":False})
+    j=m.Journal(tmp_path)
+    client=m.DirectClient("offline",j,mode="reconcile",transport=httpx.MockTransport(transport))
+    client.jwt="offline"
+    reference=dict(ref(),stage="PREDICT_ACK_OBSERVED")
+    m.reconcile(client,j,reference,0)
+    assert len(calls)==1 and calls[0].method=="GET" and client.place_calls==0
+    assert m.classify_outcome(j,reference,"API_REJECTED")=="PREDICT_ACK_OBSERVED_RECONCILIATION_INCOMPLETE"
+    assert next(r for r in j.rows if r['event']=='reconciliation_incomplete')['retry_after_seconds']==30
+    j.add("wallet_order_event",canonical_match=True,event_type="orderTransactionSuccess")
+    assert m.classify_outcome(j,reference,"API_REJECTED")=="PREDICT_SETTLEMENT_SUCCESS_OBSERVED"
+    j.add("order_observation",canonical_match=True,status="FILLED",positive_fill_observed=True)
+    assert m.classify_outcome(j,reference,"API_REJECTED")=="PREDICT_FILLED_CONFIRMED"
+    client.close()
