+def test_ack_vendor_reference_fill_observation_are_distinct(tmp_path):
+    j = Journal(tmp_path)
+    j.add("book_anchor", {"wall_ns": 0, "mono_ns": 1000000})
+    j.add("binance_ack_observed", {"wall_ns": 0, "mono_ns": 100000000})
+    empty = summarize(j, "ACK", "submit")
+    assert empty["round_ms"]["ack_to_first_positive_fill_observation"] is None
+    assert order_evidence({"orders": [{"orderId": "OTHER", "filledShareQty": "1", "filledUsdtAmount": "1"}]}, "EXACT") is None
+    evidence = order_evidence({"orders": [{"orderId": "EXACT", "vendor": "PREDICT_FUN", "vendorOrderId": "PRIVATE-VENDOR-ID",
+                                           "status": "FILLED", "filledShareQty": "1", "filledUsdtAmount": "1", "terminalTime": 999}]}, "EXACT")
+    j.add("order_observation", {"wall_ns": 0, "mono_ns": 150000000}, **evidence)
+    report = summarize(j, "ACK", "submit")
+    assert report["round_ms"]["ack_to_first_positive_fill_observation"] == 50
+    assert report["actual_fill_time_ms"] is None
+    assert report["predict_internal_acceptance_time_ms"] is None
