+def test_book_version_is_not_transport_timestamp_and_negative_age_is_retained(tmp_path):
+    received = {"wall_ns": 1000000000, "mono_ns": 2000000}
+    row = parse_frame(json.dumps({"type": "DATA", "timestamp": 1000, "data": {"msgType": "orderbook", "marketId": 7, "updateTimestampMs": 1200}}), "prediction", received, 7)
+    assert row["exchange_emission_ms"] is None
+    j = Journal(tmp_path)
+    j.add("clock_model", {"wall_ns": 0, "mono_ns": 1}, offset_ms=0, uncertainty_ms=6, rtt_ms=10)
