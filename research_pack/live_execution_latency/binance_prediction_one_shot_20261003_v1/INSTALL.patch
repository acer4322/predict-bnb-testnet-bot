+@pytest.mark.parametrize("changes", [{"amountIn": str(AMOUNT+1)}, {"tokenId": "DOWN-TOKEN"}, {"vendor": "OTHER"},
+                                    {"side": "SELL"}, {"orderType": "LIMIT"}, {"expireAt": 1}, {"walletAddress": "OTHER"}])
+def test_quote_contract_cannot_change_budget_side_vendor_or_expiry(changes):
