+def test_successful_mock_uses_fixed_market_fok_and_exactly_one_place(tmp_path):
+    calls = []
+    def handler(request):
+        params = parse_qs(request.content.decode())
+        calls.append(request.url.path)
+        if request.url.path == QUOTE_PATH:
+            assert params["amountIn"] == [str(AMOUNT)]
+            assert params["side"] == ["BUY"] and params["tokenId"] == ["UP-TOKEN"]
+            return httpx.Response(200, json=quote())
+        assert params["orderType"] == ["MARKET"] and params["timeInForce"] == ["FOK"]
+        assert "priceLimit" not in params and "fundTransferAmount" not in params
+        return httpx.Response(200, json={"orderId": "PRIVATE-ORDER"})
+    client, j = context(tmp_path, handler)
+    attempt(client, j, tmp_path)
+    assert calls == [QUOTE_PATH, PLACE_PATH]
+    assert client.place_calls == 1
+    report = summarize(j, "ACK", "submit")
+    assert report["round_ms"]["place_call_to_ack"] is not None
+    assert report["round_ms"]["ack_to_first_positive_fill_observation"] is None
+    assert "PRIVATE-ORDER" not in json.dumps(report)
+
+
+def test_reboot_clock_domains_cannot_produce_cross_boot_latency(tmp_path):
+    j = Journal(tmp_path)
+    j.clock_domain = "BEFORE-BOOT"
+    j.add("book_anchor", {"wall_ns": 0, "mono_ns": 1000000})
+    j.add("binance_ack_observed", {"wall_ns": 0, "mono_ns": 100000000})
+    j.clock_domain = "AFTER-BOOT"
+    j.add("order_observation", {"wall_ns": 0, "mono_ns": 10000000}, positive_fill_observed=True)
+    report = summarize(j, "RECONCILE", "reconcile")
+    assert report["round_ms"]["book_receipt_to_binance_ack"] == 99
+    assert report["round_ms"]["ack_to_first_positive_fill_observation"] is None
