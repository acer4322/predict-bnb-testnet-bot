+def test_wallet_push_before_ack_is_bound_later_by_exact_official_reference(tmp_path):
+    client, j = context(tmp_path, lambda request: httpx.Response(200, json={}), mode="observe")
+    reference = {}
+    feed = Feed(client, j, 7, reference)
+    def message(ref):
