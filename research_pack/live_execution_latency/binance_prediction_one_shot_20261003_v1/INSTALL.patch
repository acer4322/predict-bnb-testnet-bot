+    matched = [r for r in j.rows if r["event"] == "wallet_terminal_observation"]
+    assert len(matched) == 1 and matched[0]["mono_ns"] == 2
+    assert matched[0]["positive_fill_observed"]
+    assert all(s not in json.dumps(j.rows) for s in ("PRIVATE-ORDER", "UNRELATED-ORDER", "PRIVATE-TITLE", "pushId"))
