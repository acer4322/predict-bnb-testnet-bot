+    assert report["feed"]["prediction_book_version_age_ms"]["median_ms"] == -200
+    assert report["feed"]["prediction_transport_latency_ms"] is None
+    assert clock_model([{"rtt_ms": 50, "offset_ms": 100}, {"rtt_ms": 10, "offset_ms": 2}]) == {"offset_ms": 2, "uncertainty_ms": 6, "rtt_ms": 10}
