+import concurrent.futures
+import json
+import time
+from urllib.parse import parse_qs
+
+import httpx
+import pytest
+
+from predict_bot.binance_prediction_one_shot_latency_v1 import (
+    AMOUNT, PLACE_PATH, QUOTE_PATH, Feed, Journal, ProbeError, TimedClient, claim_once,
+    clock_model, execute_attempt, order_evidence, parse_frame, summarize, validate_quote,
+)
+
+
+def quote():
+    return {"quoteId": "PRIVATE-QUOTE", "amountIn": str(AMOUNT), "amountOut": str(2 * AMOUNT),
+            "averagePrice": .5, "vendor": "PREDICT_FUN", "tokenId": "UP-TOKEN", "side": "BUY",
+            "orderType": "MARKET", "walletAddress": "PRIVATE-WALLET", "chainId": "56",
+            "slippageBps": 1, "expireAt": int(time.time() * 1000) + 120000}
+
+
+def context(tmp_path, handler, mode="submit"):
+    http = httpx.Client(base_url="https://api.binance.com", transport=httpx.MockTransport(handler))
+    j = Journal(tmp_path)
+    client = TimedClient("PRIVATE-KEY", "PRIVATE-SECRET", j, mode=mode, http_client=http)
+    client._time_offset_ms = 0
+    return client, j
+
+
+def attempt(client, j, tmp_path):
+    execute_attempt(client, j, {"up_token_id": "UP-TOKEN", "fee_rate_bps": 200, "end_ms": int(time.time() * 1000) + 180000},
+                    {"walletAddress": "PRIVATE-WALLET", "walletId": "PRIVATE-WALLET-ID"},
+                    {"run_id": "test"}, submit=True, account_type="SPOT", guard=tmp_path / "guard.sqlite")
+
+
+def test_durable_claim_has_one_winner_and_survives_reopen(tmp_path):
+    def claim(i):
+        try:
+            claim_once(tmp_path / "guard.sqlite", str(i))
+            return True
+        except ProbeError:
+            return False
+    with concurrent.futures.ThreadPoolExecutor(max_workers=4) as pool:
+        assert sum(pool.map(claim, range(4))) == 1
+    assert not claim(99)
+
+
+def test_rejected_one_usdt_quote_does_not_place_or_retry(tmp_path):
+    calls = []
+    def handler(request):
+        calls.append(request.url.path)
+        return httpx.Response(400, json={"code": -9000, "msg": "PRIVATE-DETAIL"})
+    client, j = context(tmp_path, handler)
+    with pytest.raises(ProbeError):
+        attempt(client, j, tmp_path)
+    assert calls == [QUOTE_PATH]
+    with pytest.raises(ProbeError, match="GUARD_ALREADY"):
+        attempt(client, j, tmp_path)
+    assert calls == [QUOTE_PATH]
+    assert client.place_calls == 0
+    report = summarize(j, "REJECTED", "submit")
+    assert report["api_rejections"] == [{"http_status": 400, "api_code": -9000}]
+    assert report["round_ms"]["quote_call"] is not None
+    assert "PRIVATE-DETAIL" not in json.dumps(j.rows)
+
+
+def test_placement_timeout_is_consumed_before_send_and_never_retried(tmp_path):
+    calls = []
+    def handler(request):
+        calls.append(request.url.path)
+        if request.url.path == QUOTE_PATH:
+            return httpx.Response(200, json=quote())
+        raise httpx.ReadTimeout("PRIVATE-SECRET signed URL", request=request)
+    client, j = context(tmp_path, handler)
+    with pytest.raises(ProbeError):
+        attempt(client, j, tmp_path)
+    assert calls == [QUOTE_PATH, PLACE_PATH]
+    assert client.place_calls == 1
+    reference = json.loads((tmp_path / "PRIVATE_REFERENCE.json").read_text())
+    assert reference["stage"] == "PLACE_OUTCOME_UNKNOWN_NO_RETRY"
+    with pytest.raises(ProbeError):
+        attempt(client, j, tmp_path)
+    with pytest.raises(ProbeError):
+        client.signed_post(PLACE_PATH, {})
+    assert calls == [QUOTE_PATH, PLACE_PATH]
+    assert all(s not in json.dumps(j.rows) for s in ("PRIVATE-SECRET", "PRIVATE-WALLET", "PRIVATE-KEY", "PRIVATE-QUOTE"))
+
+
+def test_observe_mode_cannot_write_even_when_flag_is_set(tmp_path):
+    calls = []
+    client, _ = context(tmp_path, lambda request: calls.append(request), mode="observe")
+    client.place_authorized = True
+    for path in (PLACE_PATH, QUOTE_PATH, "/arbitrary-write"):
+        with pytest.raises(ProbeError):
+            client.signed_post(path, {})
+    assert calls == []
