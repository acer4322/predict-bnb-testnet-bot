from __future__ import annotations

"""Forward-only Target wallet + public full-book collector for non-5m crypto markets.

This module intentionally reuses the BTC/ETH 5m Maker-book schema and V2.1
consumable lifecycle inference so downstream research can consume nearly the
same fields.  One process owns exactly one asset/timeframe pair.  Market
selection is strict on category duration, so BTC 1H does not depend on a guessed
slug (Predict currently uses human-readable hourly category slugs).

Retention is intentionally rolling: DB rows, per-market execution archives and
Target fills expire together after the configured retention window.  Raw L2 is
only pruned after the per-market archive exists, then the archive itself is
removed when it becomes older than the same window.  SQLite incremental vacuum
and WAL truncation are used so deleted rows actually release disk pages.
"""

import json
import math
import os
import sqlite3
import threading
import time
from datetime import datetime
from pathlib import Path
from typing import Any

ROOT = Path(__file__).resolve().parents[2]
ASSET = str(os.environ.get("PREDICT_TARGET_MTF_ASSET", "BTC")).strip().upper()
TIMEFRAME = str(os.environ.get("PREDICT_TARGET_MTF_TIMEFRAME", "15M")).strip().upper()
PORT = int(os.environ.get("PREDICT_TARGET_MTF_PORT", "8793"))
RETENTION_HOURS = max(24.0, float(os.environ.get("PREDICT_TARGET_MTF_RETENTION_HOURS", "72")))
TARGET_POLL_SECONDS = max(0.75, float(os.environ.get("PREDICT_TARGET_MTF_TARGET_POLL_SECONDS", "2.0")))
DISCOVERY_SECONDS = max(2.0, float(os.environ.get("PREDICT_TARGET_MTF_DISCOVERY_SECONDS", "5.0")))

TIMEFRAME_SECONDS = {"15M": 15 * 60, "1H": 60 * 60}
TIMEFRAME_QUERY = {"15M": "15m", "1H": "1h"}
if ASSET not in {"BTC", "ETH"}:
    raise ValueError(f"unsupported multi-timeframe asset: {ASSET}")
if TIMEFRAME not in TIMEFRAME_SECONDS:
    raise ValueError(f"unsupported multi-timeframe interval: {TIMEFRAME}")
if ASSET == "ETH" and TIMEFRAME == "1H":
    # Not launched by the current project request, but keeping the module guard
    # explicit prevents an accidental unsupported service identity.
    raise ValueError("ETH 1H is not enabled by the current collector bundle")

LABEL = f"{ASSET.lower()}{TIMEFRAME.lower()}"
DEFAULT_DB = ROOT / "data" / f"wallet_maker_book_inference_{LABEL}.db"
DB_PATH = Path(os.environ.get("PREDICT_TARGET_MTF_DB", str(DEFAULT_DB)))
ARCHIVE_DIR = ROOT / "data" / "execution_tape_multitimeframe_v1" / LABEL / "markets"

# Freeze the inherited service identity before importing the generic 5m code.
os.environ["PREDICT_WALLET_MAKER_BOOK_ASSET"] = ASSET
os.environ["PREDICT_WALLET_MAKER_BOOK_PORT"] = str(PORT)
os.environ["PREDICT_WALLET_MAKER_BOOK_DB"] = str(DB_PATH)
os.environ["PREDICT_WALLET_MAKER_BOOK_RETENTION_HOURS"] = str(RETENTION_HOURS)
os.environ["PREDICT_WALLET_MAKER_TARGET_INFERENCE_ENABLED"] = "true"
os.environ.setdefault("PREDICT_WALLET_MAKER_BOOK_STATE_CACHE_REFRESH_MS", "15000")

from . import predict_wallet_maker_book_inference_collector as base  # noqa: E402
